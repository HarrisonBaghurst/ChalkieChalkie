{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "chalkiechalkie-realtime",
    "main": "src/index.ts",
    // Bounded by the wrangler pinned in package.json, which is the newest
    // release that still runs on Node 20. Raise both together.
    "compatibility_date": "2026-05-01",
    "observability": {
        "enabled": true
    },
    // workers.dev is on the public suffix list and is blocked by a lot of school
    // and corporate filters, which would look like a board that loads but never
    // syncs. Requires chalkiechalkie.com to be on Cloudflare DNS.
    "routes": [
        {
            "pattern": "realtime.chalkiechalkie.com",
            "custom_domain": true
        }
    ],
    "workers_dev": false,
    "durable_objects": {
        "bindings": [
            {
                "name": "BOARD_ROOM",
                "class_name": "BoardRoomV2"
            }
        ]
    },
    // Applied tags cannot be removed or edited, so this array only ever grows.
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["BoardRoom"]
        },
        {
            "tag": "v2",
            "new_sqlite_classes": ["BoardRoomV2"]
        },
        {
            "tag": "v3",
            "deleted_classes": ["BoardRoom"]
        }
    ]
}
